# Point this at any OTLP/gRPC collector. Leave it unset and the service runs
# with tracing switched off entirely - no provider, no exporter, no overhead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Read by the OpenTelemetry SDK itself, not by this app's code.
OTEL_SERVICE_NAME=hello-otel
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_always_on
